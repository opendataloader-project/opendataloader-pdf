{
  "schema": 1,
  "about": "Review profile of this repository. It describes what a pull request review of this repository needs beyond the generic checks: path categories, bots, scan rules, tools, and the file catalog.json. Read from the main branch only.",
  "catalog": "catalog.json",
  "source_dirs": ["(^|/)(java/[^/]+/src|python/[^/]+/src|python/[^/]+/tests|node/[^/]+/src|node/[^/]+/test)/"],
  "categories": {
    "before_build": [
      {"category": "tooling", "prefix": ["verification/", "build-scripts/"], "basename": ["checkstyle.xml", "spotbugs-exclude.xml"], "regex": ["^(node|python)/[^/]+/scripts/"]}
    ],
    "after_build": [
      {"category": "test", "regex": ["/src/test/", "^python/[^/]+/tests/", "^node/[^/]+/test/", "\\.test\\.[jt]sx?$"]},
      {"category": "samples", "prefix": ["samples/"]},
      {"category": "skill", "prefix": ["skills/"]},
      {"category": "code", "regex": ["^(java/[^/]+/src/main/|python/[^/]+/src/|node/[^/]+/src/)"]},
      {"category": "docs", "prefix": ["content/"]}
    ]
  },
  "sensitive_categories": ["workflow", "tooling", "build", "instruction", "skill"],
  "ci_risky_categories": ["workflow", "tooling", "build", "instruction"],
  "scan": {"corpus_globs": ["*/src/test/resources/*"], "test_config_regex": ["/src/test/resources/(junit-platform\\.properties|META-INF/services/)", "/src/test/resources/.*\\.properties$"], "documents": [{"name": "pdf", "magic": "%PDF", "window": 1024, "extensions": [".pdf"], "active": "/(JavaScript|JS|Launch|EmbeddedFiles?|RichMedia|XFA|SubmitForm|ImportData|OpenAction|AA)\\b", "stream_marker": "/ObjStm", "note": "the text is compressed: extract it with the CLI of main in an isolated run, then scan the text for personal data"}]},
  "suite": {"overlay_test_regex": ["(?:^|/)src/test/java/(.+)\\.java$"]},
  "precedents": {"markers": ["acrobat", "verapdf"]},
  "bots": {"review": ["coderabbitai", "coderabbitai[bot]"]},
  "cla": {"status": "license/cla", "bot": "CLAassistant", "recheck_url": "https://cla-assistant.io/check/{repo}?pullRequest={number}"},
  "reminders": {"markers": ["<!-- odl-pr-reminder -->", "This comment was generated by AI and may contain mistakes."], "labels": ["needs-cla", "stale"], "stale_label": "stale", "workflow": "scripts/pr-reminders.py"},
  "isolation": {"image": "maven:3.9-eclipse-temurin-17", "env": ["JAVA_TOOL_OPTIONS=-Djava.awt.headless=true -Djava.io.tmpdir=/tmp", "MAVEN_OPTS=-Duser.home=/tmp -Djava.awt.headless=true"], "exclude": ["target/"], "notes": "tools.md"},
  "commands": {"build": "./scripts/build-java.sh", "test": "./scripts/test-java.sh", "build-python": "./scripts/build-python.sh", "test-python": "./scripts/test-python.sh", "build-node": "./scripts/build-node.sh", "test-node": "./scripts/test-node.sh", "bench": "./scripts/bench.sh"},
  "tools": {"side_effects": {"file": "side_effects.sh", "where": "isolated", "checks": ["Q2-corpus", "Q2-tagged"]}, "bench": {"file": "bench.py", "where": "host (isolated conversion first)", "checks": ["Q2-benchmark"]}, "inspect_pdf": {"file": "inspect_pdf.py", "where": "isolated (reads bytes that the PR's code made)", "needs": ["qpdf"], "checks": ["Q2-tagged"]}, "md_lists": {"file": "md_lists.py", "where": "isolated (reads Markdown that the PR's code made)", "needs": ["markdown-it-py"], "checks": ["Q2-format"]}},
  "docs": {"tools": "tools.md", "checks": "checks.md", "samples": "samples.md"},
  "merge": {"method": "rebase"},
  "feedback": {"tracking_title": "odl skills feedback"},
  "evals": "evals/run.py"
}
